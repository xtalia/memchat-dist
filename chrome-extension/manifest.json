{
  "manifest_version": 3,
  "name": "Хатико · Memchat",
  "description": "Мемный чат: вкладки, история по режимам, расписание «Кто/Где», настройки вкладкой, ХатикоХакер",
  "version": "8.9.0.6",
  "version_name": "8.9.0-chrome.6",
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://*.bitrix24.ru/*",
    "https://*.hatiko.ru/*",
    "https://api.moysklad.ru/*",
    "https://docs.google.com/*",
    "https://github.com/*",
    "https://hatiko.ru/*",
    "https://online.moysklad.ru/*",
    "https://panel.hatiko.ru/*",
    "https://raw.githubusercontent.com/*"
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Показать / скрыть Мемчат",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://online.moysklad.ru/*",
        "https://*.bitrix24.ru/*",
        "https://*.hatiko.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
