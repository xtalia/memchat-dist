{
  "manifest_version": 3,
  "name": "Хатико · Memchat",
  "description": "Мемный чат: вкладки, история по режимам, расписание «Кто/Где», настройки вкладкой, ХатикоХакер",
  "version": "8.9.0.1",
  "version_name": "8.9.0-alpha.1-chrome.1",
  "minimum_chrome_version": "120",
  "host_permissions": [
    "https://*.bitrix24.ru/*",
    "https://*.hatiko.ru/*",
    "https://api.moysklad.ru/*",
    "https://docs.google.com/*",
    "https://github.com/*",
    "https://hatiko.ru/*",
    "https://online.moysklad.ru/*",
    "https://panel.hatiko.ru/*",
    "https://raw.githubusercontent.com/*"
  ],
  "permissions": [
    "activeTab",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Показать / скрыть Мемчат"
  },
  "content_scripts": [
    {
      "matches": [
        "https://online.moysklad.ru/*",
        "https://*.bitrix24.ru/*",
        "https://*.hatiko.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
